#include <stdio.h>

int main() {
    int x[5];
    int i;
    int recor; // Maior número
    float media, soma = 0.0;

    for(i = 0; i < 5; i++) {
        printf("Digite um número: ");
        scanf("%d", &x[i]);
    }

    recor = x[0]; // Inicializa com o primeiro número

    for(i = 0; i < 5; i++) {
        soma += x[i];
        if(x[i] > recor) {
            recor = x[i];
        }
    }

    media = soma / 5;

    if(recor > media) {
        printf("O maior número é: %d\n", recor);
    }

    printf("A média é: %.2f\n", media);

    return 0;
}
